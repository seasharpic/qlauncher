<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>2.1.0.1</Version>
    <AssemblyVersion>2.1.0.1</AssemblyVersion>
    <FileVersion>2.1.0.1</FileVersion>
    <Title>QLauncher</Title>
    <Description>Современный кастомный лаунчер Minecraft (Avalonia UI)</Description>
  </PropertyGroup>

  <!-- Платформо-независимое ядро лежит рядом; исключаем из компиляции основного проекта
       и подключаем отдельной ссылкой. -->
  <ItemGroup>
    <Compile Remove="QLauncher.Core\**" />
    <EmbeddedResource Remove="QLauncher.Core\**" />
    <None Remove="QLauncher.Core\**" />
    <AvaloniaResource Remove="QLauncher.Core\**" />
    <AvaloniaXaml Remove="QLauncher.Core\**" />
    <Compile Remove="QLauncher.Android\**" />
    <EmbeddedResource Remove="QLauncher.Android\**" />
    <None Remove="QLauncher.Android\**" />
    <AvaloniaResource Remove="QLauncher.Android\**" />
    <AvaloniaXaml Remove="QLauncher.Android\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="QLauncher.Core\QLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="fNbt" Version="1.0.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="bg.png" />
    <AvaloniaResource Include="logo.ico" />
    <AvaloniaResource Include="logo.png" />
    <AvaloniaResource Include="Assets\**\*.png" />
    <AvaloniaResource Include="Assets\**\*.jpg" />
    <Content Include="logo.ico" />
  </ItemGroup>

</Project>
