<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MinecraftLauncher.Views.Windows.QMessageBoxWindow"
        Title="{DynamicResource Str_MessageBox_WindowTitle}"
        Width="420"
        SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#1A1C28" CornerRadius="12" Margin="20" BoxShadow="0 5 20 0 #99000000">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border x:Name="TopAccent" Height="4" VerticalAlignment="Top" Background="#3B85E6" CornerRadius="12,12,0,0"/>

            <TextBlock x:Name="TitleText" Grid.Row="0"
                       Text="{DynamicResource Str_MessageBox_DefaultTitle}"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       Margin="20,15,20,10"/>

            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Text="{DynamicResource Str_MessageBox_DefaultText}"
                       Foreground="#D1D5DB" FontSize="14"
                       Margin="20,0,20,20" TextWrapping="Wrap"/>

            <Border Grid.Row="2" Background="#232634" CornerRadius="0,0,12,12" Padding="15">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"/>
            </Border>
        </Grid>
    </Border>
</Window>
