<Window x:Class="MinecraftLauncher.Views.Windows.SkinPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Skin3D_Title}" Height="640" Width="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Inter">

    <Border x:Name="OuterBorder" CornerRadius="14" ClipToBounds="True"
            Background="{DynamicResource ModpackOverlayBgBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="{DynamicResource TitleBarBrush}" CornerRadius="10,10,0,0">
                <Grid Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str_Skin3D_Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE8BB;" Style="{DynamicResource CloseButtonStyle}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3D Scene -->
            <Border Grid.Row="1" Margin="15,12,15,0" Background="{DynamicResource PanelBrush}" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Viewport3D x:Name="Viewport" ClipToBounds="True"
                                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                MouseMove="Viewport_MouseMove"
                                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                                MouseWheel="Viewport_MouseWheel">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="Camera"
                                               Position="0,0,-68"
                                               LookDirection="0,0,1"
                                               UpDirection="0,1,0"
                                               FieldOfView="40"/>
                        </Viewport3D.Camera>

                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#FF8A8A8A"/>
                                    <DirectionalLight Color="#FFFFFFFF" Direction="0.35,0.35,-1"/>
                                    <DirectionalLight Color="#FF555555" Direction="-0.3,-0.6,0.8"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>

                        <ModelVisual3D x:Name="ModelContent"/>
                    </Viewport3D>

                    <!-- Caption hint -->
                    <TextBlock Text="{DynamicResource Str_Skin3D_Hint}" IsHitTestVisible="False"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                </Grid>
            </Border>

            <!-- Status / error overlay -->
            <TextBlock x:Name="StatusText" Grid.Row="1" IsHitTestVisible="False"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0,15,54"/>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource HoverOverlayBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                <Grid Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="SlimCheckBox" Content="{DynamicResource Str_Skin3D_Slim}"
                                  Style="{StaticResource CustomCheckBox}" VerticalAlignment="Center"
                                  Margin="0,0,16,0" Checked="SlimCheckBox_Changed" Unchecked="SlimCheckBox_Changed"/>
                        <CheckBox x:Name="AutoRotateCheckBox" Content="{DynamicResource Str_Skin3D_AutoRotate}"
                                  Style="{StaticResource CustomCheckBox}" VerticalAlignment="Center" IsChecked="True"
                                  Checked="AutoRotateCheckBox_Changed" Unchecked="AutoRotateCheckBox_Changed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Str_Skin3D_Open}" Height="32" Width="100" Margin="0,0,8,0"
                                Style="{StaticResource DarkButtonStyle}" FontSize="13" Click="OpenButton_Click"/>
                        <Button Content="{DynamicResource Str_Skin3D_Save}" Height="32" Width="120"
                                Style="{StaticResource DarkButtonStyle}" FontSize="13" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
