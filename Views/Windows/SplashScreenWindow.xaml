<Window x:Class="MinecraftLauncher.Views.Windows.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QLauncher" Height="380" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Loaded="Window_Loaded" FontFamily="Inter">

    <Border CornerRadius="16" Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="10" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,20"/>
                <TextBlock Text="QLauncher" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Next-Generation Minecraft Launcher" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,30"/>

                <Border Width="300" Height="6" Background="{DynamicResource WindowBorderBrush}" CornerRadius="3">
                    <Border x:Name="ProgressBarFill" Width="20" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="3"/>
                </Border>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Str_Splash_Starting}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
