<Window x:Class="MinecraftLauncher.Views.Windows.GameConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:GameConsoleViewModel}"
        Title="{DynamicResource Str_Console_WindowTitle}" Height="520" Width="920"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Inter">

    <Border x:Name="OuterBorder" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="{DynamicResource TitleBarBrush}" CornerRadius="10,10,0,0">
                <Grid Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str_Console_Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE921;" Style="{DynamicResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
                        <Button Content="&#xE922;" Style="{DynamicResource CaptionButtonStyle}" Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseBtn" Content="&#xE8BB;" Style="{DynamicResource CloseButtonStyle}" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Console Log Container -->
            <Border Grid.Row="1" Margin="15,12" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="8">
                <Border CornerRadius="8" Background="{DynamicResource InputNicknameBgBrush}" ClipToBounds="True">
                    <RichTextBox x:Name="LogRichTextBox" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" 
                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                 Padding="12" BorderThickness="0">
                        <FlowDocument>
                            <Paragraph x:Name="LogParagraph"/>
                        </FlowDocument>
                    </RichTextBox>
                </Border>
            </Border>

            <!-- Footer Controls -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource HoverOverlayBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                <Grid Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{DynamicResource Str_Console_AutoScroll}" IsChecked="{Binding AutoScroll, Mode=TwoWay}" Style="{StaticResource CustomCheckBox}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="{Binding ProcessStatusText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Str_Console_CopyAll}" Command="{Binding CopyLogCommand}" Height="32" Width="130" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}" FontSize="13"/>
                        <Button Content="{DynamicResource Str_Console_Clear}" Command="{Binding ClearLogCommand}" Height="32" Width="90" Style="{StaticResource DarkButtonStyle}" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
