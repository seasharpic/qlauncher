<Page x:Class="MinecraftLauncher.Views.Pages.ProfileManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:ProfileManagerViewModel}"
      Title="Управление сборкой" Background="Transparent"
      FontFamily="Inter">

    <Page.Resources>
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource InputNicknameBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{DynamicResource DarkButtonStyle}" Width="36" Height="36" Click="BackButton_Click" ToolTip="Назад"/>
                            <TextBlock Text="{Binding TitleText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PlaytimeText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="51,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="CreatePack_Click" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Создать новую сборку">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Новая сборка" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportZipCommand}" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Экспортировать сборку в Zip">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Экспорт Zip" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="CreateShortcut_Click" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Создать ярлык на рабочий стол">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ярлык" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="DeletePack_Click" Height="36" Padding="14,0" Foreground="#FF6363" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Удалить сборку">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="TabModsRadio" Content="Установленные моды" IsChecked="{Binding IsModsTabSelected, Mode=TwoWay}" Style="{StaticResource TabRadioButtonStyle}" Margin="0,0,10,0" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabWorldsRadio" Content="Миры и бэкапы" Style="{StaticResource TabRadioButtonStyle}" Checked="Tab_Checked"/>
                    </StackPanel>
                </Grid>

                <!-- MODS VIEW -->
                <Grid x:Name="ModsView" Grid.Row="2" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Right">
                        <Button Command="{Binding CheckModUpdatesCommand}" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Проверить наличие обновлений модов на Modrinth">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Проверить обновления" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenModsFolderCommand}" Height="36" Padding="14,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Папка mods" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock Text="Моды в этой сборке пока не найдены. Вы можете перетащить .jar файлы сюда или загрузить их через Каталог модов." 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LocalMods.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding LocalMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,8" Padding="14,12">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding ActionText}"
                                                              Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Показать в проводнике"
                                                              Command="{Binding DataContext.OpenModInExplorerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Открыть конфиг мода"
                                                              Command="{Binding DataContext.OpenModConfigCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Найти на Modrinth"
                                                              Command="{Binding DataContext.SearchModOnModrinthCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Удалить мод"
                                                              Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF6363"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="{Binding ActionText}" 
                                                        Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" Margin="0,0,8,0" Height="32" Padding="12,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" Height="32" Width="36" Foreground="#FF6363" Style="{DynamicResource DarkButtonStyle}" ToolTip="Удалить мод"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- WORLDS VIEW -->
                <Grid x:Name="WorldsView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Right">
                        <Button Command="{Binding OpenWorldsFolderCommand}" Height="36" Padding="14,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Папка saves" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Active Worlds Heading -->
                            <TextBlock Text="{DynamicResource Str_Worlds_ActiveWorlds}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,8"/>

                            <TextBlock Text="{DynamicResource Str_Worlds_NoWorlds}" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="20,10,20,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Worlds.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Worlds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True" Background="#111">
                                                    <Image Source="{Binding IconPath}" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorldName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding LastPlayedText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{DynamicResource Str_Worlds_CreateBackup}" 
                                                            Command="{Binding DataContext.BackupWorldCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" Height="32" Padding="12,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                    <Button Content="{DynamicResource Str_Action_Delete}" 
                                                            Command="{Binding DataContext.DeleteWorldCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" Height="32" Padding="12,0" Foreground="#FF6363" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Backups Heading -->
                            <TextBlock Text="{DynamicResource Str_Worlds_Backups}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="4,16,0,8"/>

                            <TextBlock Text="{DynamicResource Str_Worlds_NoBackups}" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="20,10,20,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Backups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,12,0" Background="#1B2230">
                                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorldName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0">
                                                        <Run Text="{Binding DisplayDate, Mode=OneWay}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding DisplaySize, Mode=OneWay}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{DynamicResource Str_Action_Restore}" 
                                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" Height="32" Padding="12,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                    <Button Content="{DynamicResource Str_Action_Delete}" 
                                                            Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" Height="32" Padding="12,0" Foreground="#FF6363" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
