<Page x:Class="MinecraftLauncher.Views.Pages.ModpacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:MinecraftLauncher.Helpers"
      xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:ModpacksViewModel}"
      Title="{DynamicResource Str_Modpacks_Title}" Background="Transparent"
      FontFamily="Inter">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="20,15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="38" Height="38" Style="{StaticResource DarkButtonStyle}" Click="BackButton_Click" ToolTip="{DynamicResource Str_Action_Back}" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Modpacks_Header}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Str_Modpacks_Subheader}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Height="36" Padding="14,0" Style="{StaticResource DarkButtonStyle}" Click="ImportZip_Click" Margin="0,0,10,0" ToolTip="{DynamicResource Str_Modpacks_ImportTooltip}" FontSize="13">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Modpacks_ImportBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Height="36" Padding="14,0" Style="{StaticResource PlayButtonStyle}" Click="CreatePack_Click" FontSize="13">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Modpacks_NewBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="20">
            <Grid>
                <TextBlock Text="{DynamicResource Str_Modpacks_Empty}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Modpacks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Modpacks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="290" Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1.5" CornerRadius="14" Margin="0,0,16,16" Padding="16" helpers:Card3DTiltHelper.Enable3DTilt="True">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Str_Modpacks_Menu_Play}"
                                                      Command="{Binding DataContext.SelectPackCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding Name}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{DynamicResource Str_Modpacks_Menu_Manage}"
                                                      Command="{Binding DataContext.ManagePackCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding Name}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{DynamicResource Str_Modpacks_Menu_OpenFolder}"
                                                      Command="{Binding DataContext.OpenPackFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding Name}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{DynamicResource Str_Modpacks_Menu_OpenMods}"
                                                      Command="{Binding DataContext.OpenPackModsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding Name}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{DynamicResource Str_Modpacks_Menu_Shortcut}"
                                                      Command="{Binding DataContext.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding Name}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{DynamicResource Str_Modpacks_Menu_Clone}"
                                                      Command="{Binding DataContext.DuplicatePackCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding Name}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource Str_Modpacks_Menu_Delete}"
                                                      Command="{Binding DataContext.DeletePackCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding Name}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF6363"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.3" BlurRadius="10"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,3" Visibility="{Binding IsActiveVisibility}">
                                                <TextBlock Text="{DynamicResource Str_Modpacks_ActiveBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding LoaderTag}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="6" Padding="8,4">
                                                <TextBlock Text="{Binding GameVersionTag}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="{Binding PlaytimeText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,15"/>

                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Height="36" Style="{StaticResource PlayButtonStyle}" Tag="{Binding Name}" Click="SelectPack_Click" Margin="0,0,8,0" FontSize="13">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Modpacks_SelectBtn}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Width="36" Height="36" Style="{StaticResource DarkButtonStyle}" Tag="{Binding Name}" Click="ManagePack_Click" ToolTip="{DynamicResource Str_Modpacks_CardManageTooltip}">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
