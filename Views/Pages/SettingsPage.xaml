<Page x:Class="MinecraftLauncher.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      Title="Настройки" FontFamily="Inter">

    <Page.Resources>
        <Style x:Key="ThemeCardRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ThemeSelectionGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OuterCard"
                                CornerRadius="10"
                                Background="{DynamicResource InputNicknameBgBrush}"
                                BorderBrush="{DynamicResource WindowBorderBrush}"
                                BorderThickness="2"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCard" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="OuterCard" Property="Background" Value="{DynamicResource InputBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button HorizontalAlignment="Left" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="40" Height="40" Style="{StaticResource DarkButtonStyle}" Click="BackButton_Click" ToolTip="Назад"/>
            <TextBlock Text="Настройки" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="15" Padding="25">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="ОСНОВНЫЕ" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Str_Settings_Language}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton Style="{StaticResource ThemeCardRadioStyle}" 
                                     GroupName="LanguageSelectionGroup"
                                     IsChecked="{Binding IsRussianLanguage, Mode=OneWay}"
                                     Command="{Binding ChangeLanguageCommand}"
                                     CommandParameter="ru"
                                     Width="140" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,8">
                                <TextBlock Text="Русский" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ThemeCardRadioStyle}" 
                                     GroupName="LanguageSelectionGroup"
                                     IsChecked="{Binding IsEnglishLanguage, Mode=OneWay}"
                                     Command="{Binding ChangeLanguageCommand}"
                                     CommandParameter="en"
                                     Width="140">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,8">
                                <TextBlock Text="English" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <CheckBox Content="{DynamicResource Str_Settings_CloseOnLaunch}" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding CloseOnLaunch, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Str_Settings_DiscordRpc}" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding EnableDiscordRpc, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Str_Settings_UiSounds}" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding EnableUiSounds, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Str_Settings_HideServerIp}" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding HideServerIp, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Str_Settings_AutoAddServers}" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding AutoAddServers, Mode=TwoWay}"/>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="JAVA И ПАМЯТЬ" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Str_Settings_Memory}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="1024" IsSnapToTickEnabled="True" Value="{Binding RamMb, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Text="{Binding RamMb, Mode=TwoWay}" Style="{StaticResource CustomTextBoxStyle}" Height="35" TextAlignment="Center" Padding="0" IsReadOnly="True" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Settings_JavaPath}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding JavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CustomTextBoxStyle}" Height="40" Margin="0,0,10,0" FontSize="13"/>
                        <Button Grid.Column="1" Content="Обзор..." Width="100" Height="40" Style="{StaticResource DarkButtonStyle}" Command="{Binding BrowseJavaCommand}" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Settings_JvmPreset}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <ComboBox Height="40" Style="{StaticResource CustomComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding JvmPreset, Mode=TwoWay}" Margin="0,0,0,15" Padding="12,0,0,0" VerticalContentAlignment="Center" FontSize="13">
                        <ComboBoxItem Content="Стандартный (G1GC)" Tag="default"/>
                        <ComboBoxItem Content="Aikar's Flags (Макс. FPS и плавность)" Tag="aikar"/>
                        <ComboBoxItem Content="Low Latency (ZGC / Shenandoah)" Tag="zgc_shenandoah"/>
                    </ComboBox>

                    <Button Content="{DynamicResource Str_Settings_AutoTune}" 
                            Command="{Binding AutoTuneHardwareCommand}" 
                            Height="38" Style="{StaticResource DarkButtonStyle}" 
                            HorizontalAlignment="Left" Padding="16,0" Margin="0,0,0,15" FontSize="13">
                        <Button.ToolTip>
                            <ToolTip Content="Автоматически определяет объем RAM, подбирает оптимальный профиль JVM и активирует дискретную видеокарту"/>
                        </Button.ToolTip>
                    </Button>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="ЭКРАН И ГРАФИКА" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <TextBlock Text="Видеоадаптер (Графика)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Height="40" Style="{StaticResource CustomComboBoxStyle}" 
                                  ItemsSource="{Binding GpuOptions}" 
                                  SelectedItem="{Binding SelectedGpuOption, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  Padding="12,0,0,0" VerticalContentAlignment="Center" FontSize="13"/>
                        <Button Grid.Column="1" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" 
                                Width="40" Height="40" Margin="10,0,0,0"
                                Style="{StaticResource DarkButtonStyle}" 
                                Command="{Binding RefreshGpuCommand}" 
                                ToolTip="Обновить список видеоадаптеров" FontSize="14"/>
                    </Grid>

                    <Border Background="{DynamicResource InputBgBrush}" 
                            BorderBrush="{DynamicResource WindowBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14,10" 
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveGpuSummary}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding ActiveGpuDetails}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <CheckBox Content="Запускать в полном экране (Fullscreen)" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding IsFullScreen, Mode=TwoWay}"/>

                    <TextBlock Text="Разрешение окна игры (ширина х высота)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,10,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ScreenWidth, Mode=TwoWay}" Style="{StaticResource CustomTextBoxStyle}" Height="40" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="x" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="2" Text="{Binding ScreenHeight, Mode=TwoWay}" Style="{StaticResource CustomTextBoxStyle}" Height="40" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="Собственные фоновые обои лаунчера" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomWallpaperPath, Mode=TwoWay}" Style="{StaticResource CustomTextBoxStyle}" Height="40" Margin="0,0,10,0" IsReadOnly="True" FontSize="13"/>
                        <Button Grid.Column="1" Content="Выбрать..." Width="110" Height="40" Style="{StaticResource DarkButtonStyle}" Command="{Binding BrowseWallpaperCommand}" Margin="0,0,8,0" FontSize="13"/>
                        <Button Grid.Column="2" Content="Сбросить" Width="100" Height="40" Style="{StaticResource DarkButtonStyle}" Command="{Binding ResetWallpaperCommand}" FontSize="13"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="ОФОРМЛЕНИЕ И ТЕМА" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <TextBlock Text="Режим темы" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <RadioButton Style="{StaticResource ThemeCardRadioStyle}" 
                                     GroupName="ThemeSelectionGroup"
                                     IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                     Command="{Binding SelectThemeCommand}"
                                     CommandParameter="light"
                                     Width="155" Margin="0,0,14,0">
                            <StackPanel>
                                <Border CornerRadius="7" Height="92" ClipToBounds="True" Background="#E0E6ED">
                                    <Grid>
                                        <Image Source="/Assets/theme_light.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Width="44" Height="38" CornerRadius="6" 
                                                Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                                Margin="0,0,8,8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25"/>
                                            </Border.Effect>
                                            <Border Width="22" Height="8" CornerRadius="3" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                                                    Margin="0,0,0,6"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Светлая" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,7,0,3"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource ThemeCardRadioStyle}" 
                                     GroupName="ThemeSelectionGroup"
                                     IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                     Command="{Binding SelectThemeCommand}"
                                     CommandParameter="dark"
                                     Width="155">
                            <StackPanel>
                                <Border CornerRadius="7" Height="92" ClipToBounds="True" Background="#151A22">
                                    <Grid>
                                        <Image Source="/Assets/theme_dark.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Width="44" Height="38" CornerRadius="6" 
                                                Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                                Margin="0,0,8,8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.4"/>
                                            </Border.Effect>
                                            <Border Width="22" Height="8" CornerRadius="3" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                                                    Margin="0,0,0,6"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Тёмная" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,7,0,3"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <TextBlock Text="Акцентный цвет интерфейса" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Command="{Binding SelectAccentPresetCommand}" CommandParameter="sapphire" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#3B85E6" Margin="0,0,8,0"/>
                                <TextBlock Text="Sapphire" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectAccentPresetCommand}" CommandParameter="purple" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#8B5CF6" Margin="0,0,8,0"/>
                                <TextBlock Text="Amethyst" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectAccentPresetCommand}" CommandParameter="emerald" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                                <TextBlock Text="Emerald" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectAccentPresetCommand}" CommandParameter="rose" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#F43F5E" Margin="0,0,8,0"/>
                                <TextBlock Text="Rose" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectAccentPresetCommand}" CommandParameter="amber" Height="36" Padding="14,0" Style="{StaticResource DarkButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0"/>
                                <TextBlock Text="Amber" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="{DynamicResource Str_Settings_Storage}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CacheInfoText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                            <TextBlock Text="Удаляет временные файлы, кэш скинов и старые журналы" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Settings_CleanCache}" Command="{Binding CleanCacheCommand}" Width="160" Height="40" Style="{StaticResource DarkButtonStyle}" FontSize="13"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="{DynamicResource Str_Settings_PortableMode}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PortableModeStatusText}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding DataDirectoryPath}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{DynamicResource Str_Settings_ExportPortable}" Command="{Binding ExportPortableCommand}" Height="38" Padding="16,0" Style="{StaticResource DarkButtonStyle}" Margin="0,0,10,0" FontSize="13"/>
                        <Button Content="{DynamicResource Str_Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Height="38" Padding="16,0" Style="{StaticResource DarkButtonStyle}" FontSize="13"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="ВАШИ АККАУНТЫ" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,15" Padding="5">
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid x:Name="MsLogo" Width="14" Height="14" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="#F25022" Margin="0,0,1,1"/>
                                            <Rectangle Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1"/>
                                            <Rectangle Grid.Row="1" Fill="#00A4EF" Margin="0,1,1,0"/>
                                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0"/>
                                        </Grid>

                                        <TextBlock Grid.Column="1" Text="{Binding Nickname}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontSize="13"/>
                                        <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="30" Height="30" Style="{StaticResource DarkButtonStyle}" Foreground="#E81123" 
                                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AccessToken}" Value="offline">
                                            <Setter TargetName="MsLogo" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="Оффлайн аккаунт" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OfflineNicknameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CustomTextBoxStyle}" Height="40" Margin="0,0,10,0" FontSize="13"/>
                        <Button Grid.Column="1" Content="Добавить ник" Width="140" Height="40" Style="{StaticResource DarkButtonStyle}" Command="{Binding AddOfflineAccountCommand}" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="Лицензия Microsoft" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Button Content="Добавить аккаунт Microsoft" Width="240" Height="40" HorizontalAlignment="Left" Style="{StaticResource PlayButtonStyle}" Command="{Binding LoginMicrosoftCommand}" Margin="0,0,0,25" FontSize="13"/>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,0,0,20"/>

                    <TextBlock Text="ОБНОВЛЕНИЯ И ДИАГНОСТИКА" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentVersionText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Автоматический поиск новых релизов и переключение зеркал" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Проверить сейчас" Command="{Binding CheckUpdatesManualCommand}" Width="150" Height="40" Style="{StaticResource DarkButtonStyle}" FontSize="13"/>
                    </Grid>

                    <CheckBox Content="Проверять обновления при каждом запуске" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}"/>
                    <CheckBox Content="Показывать экран заставки (Splash Screen)" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding ShowSplashOnStartup, Mode=TwoWay}"/>

                    <TextBlock Text="Канал обновлений" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,10,0,5"/>
                    <ComboBox Height="40" Style="{StaticResource CustomComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding UpdateChannel, Mode=TwoWay}" Margin="0,0,0,15" Padding="12,0,0,0" VerticalContentAlignment="Center" FontSize="13">
                        <ComboBoxItem Content="Стабильный канал (Рекомендуется)" Tag="stable"/>
                        <ComboBoxItem Content="Канал бета-тестирования (Beta)" Tag="beta"/>
                    </ComboBox>

                    <TextBlock Text="Зеркало загрузки обновлений" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <ComboBox Height="40" Style="{StaticResource CustomComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding UpdateMirror, Mode=TwoWay}" Margin="0,0,0,15" Padding="12,0,0,0" VerticalContentAlignment="Center" FontSize="13">
                        <ComboBoxItem Content="Автовыбор (GitHub с резервом на SourceForge)" Tag="auto"/>
                        <ComboBoxItem Content="GitHub Releases" Tag="github"/>
                        <ComboBoxItem Content="SourceForge Mirror" Tag="sourceforge"/>
                    </ComboBox>

                    <TextBlock Text="Лимит скорости загрузки" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <ComboBox Height="40" Style="{StaticResource CustomComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding BandwidthLimitTag, Mode=TwoWay}" Margin="0,0,0,15" Padding="12,0,0,0" VerticalContentAlignment="Center" FontSize="13">
                        <ComboBoxItem Content="Без ограничений (Максимальная)" Tag="0"/>
                        <ComboBoxItem Content="1 МБ/с (Экономный трафик)" Tag="1"/>
                        <ComboBoxItem Content="3 МБ/с (Стабильный поток)" Tag="3"/>
                        <ComboBoxItem Content="5 МБ/с" Tag="5"/>
                        <ComboBoxItem Content="10 МБ/с" Tag="10"/>
                    </ComboBox>

                    <Grid Margin="0,5,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Экспорт отчёта об ошибках" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                            <TextBlock Text="Формирует ZIP-архив с системными параметрами и логами" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Собрать отчёт (ZIP)" Command="{Binding ExportDiagnosticReportCommand}" Width="150" Height="40" Style="{StaticResource DarkButtonStyle}" FontSize="13"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,0,0,20"/>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="{DynamicResource Str_Settings_About}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/logo.png" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="QLauncher" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="v2.0.0 Release" Foreground="Black" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Str_Settings_AboutDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Designed and developed with high-performance C# / WPF and modern launch architecture." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Content="{DynamicResource Str_Action_Save}" Width="140" Height="42" HorizontalAlignment="Right" Margin="0,15,0,0" Style="{StaticResource DarkButtonStyle}" Click="BackButton_Click" FontSize="13"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
