<Window x:Class="MinecraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:MinecraftLauncher.Helpers"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="QLauncher" Height="700" Width="1100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        AllowDrop="True" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" DragOver="Window_DragOver" Drop="Window_Drop"
        FontFamily="Inter">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <helpers:ComparisonConverter x:Key="ComparisonConverter"/>

        <Style x:Key="LoaderCardRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="LoaderSelection"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource InputNicknameBgBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource InputBgBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="3">
        <Grid>
            <tb:TaskbarIcon x:Name="LauncherTrayIcon" IconSource="/logo.png" ToolTipText="QLauncher" Visibility="Collapsed" TrayMouseDoubleClick="LauncherTrayIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
                        <MenuItem Header="{DynamicResource Str_Tray_Restore}" Click="TrayRestore_Click" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Separator Background="{DynamicResource WindowBorderBrush}"/>
                        <MenuItem Header="{DynamicResource Str_Tray_Exit}" Click="TrayExit_Click" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <Border x:Name="BackgroundBorder" Background="{Binding CustomBackgroundBrush}" CornerRadius="0,0,15,15" ClipToBounds="True" Margin="0,40,0,0"/>

            <Grid x:Name="ContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border x:Name="TitleBorder" Grid.Row="0" MouseDown="Window_MouseDown" Background="{DynamicResource TitleBarBrush}" CornerRadius="10,10,0,0">
                    <Grid Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image Source="/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                            <TextBlock Text="QLauncher" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="PortableBadge" Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PORTABLE" Foreground="Black" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ThemeToggleBtn" Content="&#xE706;" Style="{DynamicResource CaptionButtonStyle}" Click="ThemeToggleBtn_Click" ToolTip="{DynamicResource Str_Tooltip_ToggleTheme}"/>
                            <Button Content="&#xE713;" Style="{DynamicResource CaptionButtonStyle}" Click="SettingsButton_Click" ToolTip="{DynamicResource Str_Tooltip_Settings}"/>
                            <Button Content="&#xE921;" Style="{DynamicResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
                            <Button Content="&#xE922;" Style="{DynamicResource CaptionButtonStyle}" Click="MaximizeButton_Click"/>
                            <Button x:Name="CloseBtn" Content="&#xE8BB;" Style="{DynamicResource CloseButtonStyle}" Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Tab Bar -->
                <Border Grid.Row="1" Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource HoverOverlayBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource NavTabButtonStyle}" Click="NavHome_Click" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_Nav_Home}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavTabButtonStyle}" Click="NavModpacks_Click" Margin="0,0,4,0" ToolTip="{DynamicResource Str_Tooltip_NavModpacks}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_Nav_Modpacks}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavTabButtonStyle}" Click="NavMods_Click" Margin="0,0,4,0" ToolTip="{DynamicResource Str_Tooltip_NavMods}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_Nav_Mods}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavTabButtonStyle}" Click="NavScreenshots_Click" Margin="0,0,4,0" ToolTip="{DynamicResource Str_Tooltip_NavScreenshots}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_Nav_Screenshots}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavTabButtonStyle}" Click="NavConsole_Click" Margin="0,0,4,0" ToolTip="{DynamicResource Str_Tooltip_NavConsole}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_Nav_Console}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid>
                                <Button x:Name="QuickFolderBtn" Style="{StaticResource NavTabButtonStyle}" Click="QuickFolderButton_Click" ToolTip="{DynamicResource Str_Tooltip_QuickFolder}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_QuickFolder}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="FoldersPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1.5" CornerRadius="16" Padding="6" Margin="0,6,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="6" Opacity="0.45" BlurRadius="20"/>
                                        </Border.Effect>
                                        <StackPanel Width="290">
                                            <Button Style="{StaticResource PopupMenuItemStyle}" Click="OpenFolder_Mods">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Folder_Mods}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemStyle}" Click="OpenFolder_ResourcePacks">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Folder_ResourcePacks}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemStyle}" Click="OpenFolder_ShaderPacks">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE781;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Folder_ShaderPacks}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemStyle}" Click="OpenFolder_Saves">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Folder_Saves}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemStyle}" Click="OpenFolder_Screenshots">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Folder_Screenshots}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemStyle}" Click="OpenFolder_Logs">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Folder_Logs}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Border Height="1" Background="{DynamicResource WindowBorderBrush}" Margin="8,6"/>

                                            <Button Style="{StaticResource PopupMenuItemStyle}" Click="OpenFolder_Root">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Str_Folder_Root}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Home View -->
                <Grid x:Name="HomeView" Grid.Row="2" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="85"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,15,20,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="241"/>
                        </Grid.ColumnDefinitions>

                        <!-- News Panel -->
                        <Border Grid.Column="0" CornerRadius="20" Margin="0,0,13,0" Background="{DynamicResource PanelBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{DynamicResource Str_News_Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" HorizontalAlignment="Center" Margin="0,15,0,15" FontFamily="Inter"/>
                                <Border Grid.Row="0" BorderBrush="{DynamicResource HoverOverlayBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                <ScrollViewer Grid.Row="1" Margin="15,10,15,15" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasNews, Converter={StaticResource BoolToVisConverter}}">
                                    <ItemsControl ItemsSource="{Binding NewsPosts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,15" Padding="15">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Date}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontFamily="Inter" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <Border CornerRadius="6" Margin="0,0,0,10" Visibility="{Binding ImageVisibility}" ClipToBounds="True">
                                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" MaxHeight="180" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontFamily="Inter" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- News Empty State -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                            Visibility="{Binding HasNews, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" FontSize="36" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Str_News_Empty}" Foreground="{DynamicResource PrimaryTextBrush}" 
                                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_News_EmptyHint}" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" 
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Opacity="0.7"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Servers Panel -->
                        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="20" ClipToBounds="True">
                            <Grid>
                                <Grid VerticalAlignment="Top" Margin="20,14,20,0" Height="36">
                                    <TextBlock Text="{DynamicResource Str_Servers_Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Inter"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Command="{Binding RefreshServersCommand}" Style="{StaticResource DarkButtonStyle}" Width="32" Height="32" Padding="0" Margin="0,0,6,0" ToolTip="{DynamicResource Str_Servers_RefreshStatus}">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        </Button>
                                        <Button Command="{Binding OpenAddServerOverlayCommand}" Style="{StaticResource DarkButtonStyle}" Width="32" Height="32" Padding="0" ToolTip="{DynamicResource Str_Servers_Join}">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border BorderBrush="{DynamicResource HoverOverlayBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,58,0,0"/>

                                <ScrollViewer Margin="0,59,0,0" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasServers, Converter={StaticResource BoolToVisConverter}}">
                                    <ItemsControl ItemsSource="{Binding Servers}" Margin="20,15,20,20">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" CornerRadius="8" Margin="0,0,0,12" Padding="2">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource Str_Servers_CopyIp}" 
                                                                      Command="{Binding DataContext.CopyServerIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding Ip}">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Str_Servers_Connect}" 
                                                                      Command="{Binding DataContext.ConnectServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding Ip}">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Str_Servers_RefreshStatus}" 
                                                                      Command="{Binding DataContext.RefreshServersCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{DynamicResource Str_Servers_Delete}" 
                                                                      Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF6363"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding OnlineText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </Grid>

                                                            <Border Height="6" Background="{DynamicResource HoverOverlayBrush}" CornerRadius="3" Margin="0,4,0,0">
                                                                <Border Width="{Binding ProgressWidth}" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="3"/>
                                                            </Border>

                                                            <Grid Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding Version}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Ellipse Width="6" Height="6" Fill="{Binding PingColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding PingText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>

                                                        <Button Grid.Column="1" Content="{DynamicResource Str_Servers_Join}" 
                                                                Command="{Binding DataContext.ConnectServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Ip}"
                                                                Padding="8,4" Margin="8,0,0,0" Style="{DynamicResource DarkButtonStyle}" FontSize="11" ToolTip="{DynamicResource Str_Servers_ConnectTooltip}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Servers Empty State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,70,20,20"
                                            Visibility="{Binding HasServers, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="36" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Str_Servers_Empty}" Foreground="{DynamicResource PrimaryTextBrush}" 
                                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_Servers_EmptyHint}" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" 
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Opacity="0.7"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Footer Controls -->
                    <Border x:Name="FooterBorder" Grid.Row="1" Background="{DynamicResource FooterBrush}" CornerRadius="0,0,12,12">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Height="45" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="NicknameComboBox" Height="45"
                                      Style="{StaticResource CustomComboBoxStyle}" Background="{DynamicResource InputNicknameBgBrush}" 
                                      Padding="10,0,0,0" VerticalContentAlignment="Center" 
                                      ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                      TextSearch.TextPath="Nickname">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0" ClipToBounds="True">
                                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <Grid x:Name="MsLogo" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{DynamicResource Str_Tooltip_MsAccount}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Rectangle Fill="#F25022" Margin="0,0,1,1"/>
                                                <Rectangle Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1"/>
                                                <Rectangle Grid.Row="1" Fill="#00A4EF" Margin="0,1,1,0"/>
                                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Nickname}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding AccessToken}" Value="offline">
                                                <Setter TargetName="MsLogo" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Менеджер аккаунтов: в самом селекторе можно только
    выбрать, к кому зайти, а добавить или удалить аккаунт было нужно
    вручную искать в настройках. -->
                                <Button x:Name="AccountManagerButton" Grid.Column="2" Width="45" Height="45"
                                        Content="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                        Click="AccountManagerButton_Click"
                                        Style="{StaticResource DarkButtonStyle}"
                                        ToolTip="{DynamicResource Str_Action_AccountManager}"/>
                            </Grid>

                            <ComboBox x:Name="VersionComboBox" SelectionChanged="VersionComboBox_SelectionChanged" 
                                      ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                      Grid.Column="1" Height="45" Margin="0,0,15,0" Style="{StaticResource CustomComboBoxStyle}" Padding="15,0,0,0" VerticalContentAlignment="Center">
                                <ComboBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Str_Version_OpenFolder}" 
                                                  Command="{Binding OpenQuickFolderCommand}" 
                                                  CommandParameter="">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_Version_OpenMods}" 
                                                  Command="{Binding OpenQuickFolderCommand}" 
                                                  CommandParameter="mods">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_Version_CreateShortcut}" 
                                                  Command="{Binding OpenShortcutOverlayCommand}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Str_Version_CreateNew}" 
                                                  Command="{Binding OpenModpackOverlayCommand}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ComboBox.ContextMenu>
                            </ComboBox>

                            <Grid x:Name="ProgressHostGrid" Grid.Column="2" Height="46" Margin="0,0,20,0" ClipToBounds="True">
                                <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="23"/>
                                <Border x:Name="ProgressFillBorder" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentBrush}" CornerRadius="23" Visibility="Collapsed"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Inter"/>
                            </Grid>

                            <Button x:Name="PlayButton" Grid.Column="3" Content="{DynamicResource Str_Action_Play}" Height="45" Style="{StaticResource PlayButtonStyle}" Command="{Binding PlayCommand}" FontFamily="Inter" FontSize="22">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Str_Action_Play}" Command="{Binding PlayCommand}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_Version_OpenGameFolder}" Command="{Binding OpenQuickFolderCommand}" CommandParameter="">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_Version_CreateShortcut}" Command="{Binding OpenShortcutOverlayCommand}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Frame x:Name="MainFrame" Grid.Row="2" NavigationUIVisibility="Hidden" Visibility="Collapsed" Background="Transparent">
                    <Frame.RenderTransform>
                        <TranslateTransform x:Name="MainFrameTransform" X="0"/>
                    </Frame.RenderTransform>
                </Frame>

                <!-- Modpack Create Overlay -->
                <Grid x:Name="ModpackOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0" Panel.ZIndex="950">
                    <Border Background="#AA000000" CornerRadius="0,0,11,11" MouseDown="CloseModpackOverlay_Click"/>
                    <Border x:Name="ModpackDialogBorder" Width="510" Height="570" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            CornerRadius="16" Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="2"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ModpackScaleTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ModpackTranslateTransform" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.5" BlurRadius="20"/>
                        </Border.Effect>
                        <Grid Margin="28,24,28,24">
                            <TextBlock Text="{DynamicResource Str_Create_Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Inter"/>

                            <StackPanel Margin="0,42,0,0">
                                <TextBlock Text="{DynamicResource Str_Create_Name}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,5" FontFamily="Inter"/>
                                <TextBox Text="{Binding NewModpackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="40" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,12" Padding="15,0"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Str_Create_GameVersion}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,5" FontFamily="Inter"/>
                                        <ComboBox x:Name="ModpackVersionBox" ItemsSource="{Binding VanillaVersions}" SelectedItem="{Binding NewModpackVersion, Mode=TwoWay}" Height="40" Style="{StaticResource CustomComboBoxStyle}" Padding="15,0,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Str_Create_Provider}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,5" FontFamily="Inter"/>
                                        <ComboBox Height="40" Style="{StaticResource CustomComboBoxStyle}" Padding="15,0,0,0" VerticalContentAlignment="Center"
                                                      IsEnabled="False" ToolTip="{DynamicResource Str_Provider_Soon}">
                                            <ComboBoxItem Content="Modrinth" IsSelected="True"/>
                                            <!-- Источника CurseForge в проекте нет: выбор проходил
молча, а пользователю возвращался Modrinth. Пока помечаем как
недоступный, чтобы список не врёл. -->
                                            <ComboBoxItem Content="{DynamicResource Str_Provider_CurseForgeSoon}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource Str_Create_Loader}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,6" FontFamily="Inter"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" Style="{StaticResource LoaderCardRadioStyle}" Margin="0,0,5,0" Height="50"
                                                 IsChecked="{Binding NewModpackLoader, Converter={StaticResource ComparisonConverter}, ConverterParameter=Vanilla}">
                                        <Grid Margin="12,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="/Assets/Loaders/vanilla.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Str_Loader_VanillaName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                                <TextBlock Text="{DynamicResource Str_Loader_VanillaDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>

                                    <RadioButton Grid.Column="1" Style="{StaticResource LoaderCardRadioStyle}" Margin="5,0,0,0" Height="50"
                                                 IsChecked="{Binding NewModpackLoader, Converter={StaticResource ComparisonConverter}, ConverterParameter=Fabric}">
                                        <Grid Margin="12,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="/Assets/Loaders/fabric.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Fabric" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                                <TextBlock Text="{DynamicResource Str_Loader_FabricDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" Style="{StaticResource LoaderCardRadioStyle}" Margin="0,0,4,0" Height="46"
                                                 IsChecked="{Binding NewModpackLoader, Converter={StaticResource ComparisonConverter}, ConverterParameter=Forge}">
                                        <Grid Margin="8,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="/Assets/Loaders/forge.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Forge" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                                <TextBlock Text="{DynamicResource Str_Loader_Soon}" Foreground="#E8A33D" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>

                                    <RadioButton Grid.Column="1" Style="{StaticResource LoaderCardRadioStyle}" Margin="3,0,3,0" Height="46"
                                                 IsChecked="{Binding NewModpackLoader, Converter={StaticResource ComparisonConverter}, ConverterParameter=NeoForge}">
                                        <Grid Margin="8,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="/Assets/Loaders/neoforge.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="NeoForge" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                                <TextBlock Text="{DynamicResource Str_Loader_Soon}" Foreground="#E8A33D" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>

                                    <RadioButton Grid.Column="2" Style="{StaticResource LoaderCardRadioStyle}" Margin="4,0,0,0" Height="46"
                                                 IsChecked="{Binding NewModpackLoader, Converter={StaticResource ComparisonConverter}, ConverterParameter=Quilt}">
                                        <Grid Margin="8,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="/Assets/Loaders/quilt.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Quilt" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                                <TextBlock Text="{DynamicResource Str_Loader_QuiltDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>
                                </Grid>

                                <StackPanel Visibility="{Binding IsFabricSelected, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{DynamicResource Str_Create_AutoInstall}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,5" FontWeight="Bold" FontFamily="Inter"/>
                                    <CheckBox Content="{DynamicResource Str_Create_Sodium}" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding InstallSodium, Mode=TwoWay}" Margin="0,0,0,4"/>
                                    <CheckBox Content="{DynamicResource Str_Create_Iris}" Style="{StaticResource CustomCheckBox}" IsChecked="{Binding InstallIris, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <Button Content="{DynamicResource Str_Action_Cancel}" Width="100" Height="42" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,0" Command="{Binding CloseModpackOverlayCommand}" FontFamily="Inter"/>
                                <Button Content="{DynamicResource Str_Create_ImportZip}" Width="120" Height="42" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,0" Command="{Binding ImportZipModpackCommand}" FontFamily="Inter" ToolTip="{DynamicResource Str_Create_ImportZipTooltip}"/>
                                <Button Content="{DynamicResource Str_Create_Submit}" Width="120" Height="42" Style="{StaticResource PlayButtonStyle}" Command="{Binding CreateModpackCommand}" FontFamily="Inter"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Loading Spinner Action Overlay -->
            <Border x:Name="ActionOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#CC0F111A" CornerRadius="0,0,11,11" 
                    Visibility="{Binding IsActionOverlayVisible, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="999">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="40" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding ActionOverlayText}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <!-- Shortcut Overlay -->
            <Grid x:Name="ShortcutOverlay" Grid.Row="1" Grid.RowSpan="2" 
                  Visibility="{Binding IsShortcutOverlayVisible, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="900">
                <Border Background="#AA000000" CornerRadius="0,0,11,11" MouseDown="CloseShortcutOverlay_Click"/>
                <Border Width="400" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.5" BlurRadius="20"/>
                    </Border.Effect>
                    <Grid Margin="30">
                        <TextBlock Text="{DynamicResource Str_Shortcut_Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Inter"/>

                        <StackPanel Margin="0,50,0,0">
                            <TextBlock Text="{DynamicResource Str_Shortcut_PickVersion}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,5" FontFamily="Inter"/>
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding ShortcutVersion, Mode=TwoWay}" Height="42" Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,0,15" Padding="15,0,0,0" VerticalContentAlignment="Center"/>

                            <TextBlock Text="{DynamicResource Str_Shortcut_IpLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,5" FontFamily="Inter"/>
                            <TextBox Text="{Binding ShortcutIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="42" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,15" Padding="15,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Button Content="{DynamicResource Str_Action_Cancel}" Width="110" Height="42" Style="{StaticResource DarkButtonStyle}" Margin="0,0,10,0" Command="{Binding CloseShortcutOverlayCommand}" FontFamily="Inter"/>
                            <Button Content="{DynamicResource Str_Create_Submit}" Width="140" Height="42" Style="{StaticResource PlayButtonStyle}" Command="{Binding CreateShortcutCommand}" FontFamily="Inter"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Add Server Overlay -->
            <Grid x:Name="AddServerOverlay" Grid.Row="1" Grid.RowSpan="2" 
                  Visibility="{Binding IsAddServerOverlayVisible, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="910">
                <Border Background="#AA000000" CornerRadius="0,0,11,11" MouseDown="CloseAddServerOverlay_Click"/>
                <Border Width="420" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="{DynamicResource ModpackOverlayBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.5" BlurRadius="20"/>
                    </Border.Effect>
                    <Grid Margin="30">
                        <TextBlock Text="{DynamicResource Str_Action_AddServer}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Inter"/>

                        <StackPanel Margin="0,46,0,0">
                            <TextBlock Text="{DynamicResource Str_AddServer_NameLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,5" FontFamily="Inter"/>
                            <TextBox Text="{Binding NewServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="40" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,14" Padding="14,0"/>

                            <TextBlock Text="{DynamicResource Str_AddServer_IpLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,5" FontFamily="Inter"/>
                            <TextBox Text="{Binding NewServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="40" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,14" Padding="14,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Button Content="{DynamicResource Str_Action_Cancel}" Width="110" Height="40" Style="{StaticResource DarkButtonStyle}" Margin="0,0,10,0" Command="{Binding CloseAddServerOverlayCommand}" FontFamily="Inter"/>
                            <Button Content="{DynamicResource Str_Action_Save}" Width="140" Height="40" Style="{StaticResource PlayButtonStyle}" Command="{Binding AddServerCommand}" FontFamily="Inter"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Drag & Drop Visual Overlay -->
            <Grid x:Name="DragDropOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="998" Background="#DD0E131F" IsHitTestVisible="False">
                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12" Margin="24" SnapsToDevicePixels="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="{DynamicResource Str_DragDrop_Overlay}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Toast Container -->
            <StackPanel x:Name="ToastContainer" Grid.Row="1" Grid.RowSpan="2" 
                        VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                        Margin="0,0,24,96" Panel.ZIndex="9999" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
