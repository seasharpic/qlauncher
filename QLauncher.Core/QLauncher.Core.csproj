<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QLauncher.Core</AssemblyName>
    <RootNamespace>QLauncher.Core</RootNamespace>
    <Version>2.0.0</Version>
    <Title>QLauncher Core</Title>
    <Description>
      Платформо-независимое ядро QLauncher: каталоги модов, обновления, Ely.by/MS-авторизация.
      Не содержит WPF-типов (TargetFramework без -windows) — компилятор не даст
      использовать System.Windows, что и есть страховка кроссплатформенности.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
  </ItemGroup>

</Project>
